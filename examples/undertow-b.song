# Undertow B — Undertow with different melodic material and a tighter arc:
# dark beats first, the synth layers next, the melody only from the break on.
# Syncopated e-piano hook, glassy 8th-note FM arp, bell counter line, swing,
# drums keying a compressor on everything else. Original.
# E minor, chord loop Em | Em | C | C | Em | Em | D | D.
#
# Built from presets only (`mat presets`); no external content needed.
# Layers (stems): drums, rumble, bass, arp, pad, lead, acid, dj, fx

title "Undertow B"
tempo 128
meter 4/4

section beats   bars=1-8
section synth   bars=9-24
section build   bars=25-32
section drop    bars=33-48
section break   bars=49-56
section build2  bars=57-64
section drop2   bars=65-96
section outro   bars=97-104
swing 0.54


# ------------------------------------------------------------ instruments

instrument kit preset techno-kit
instrument rumble preset rumble
instrument bass preset rolling-bass
  filter lowpass cutoff=300 res=0.2 env=1.6 drive=0.35
  lfo filter rate=0.03 depth=0.5
instrument arp preset pluck
  osc saw voices=2 spread=10
  filter lowpass cutoff=500 res=0.3 env=2.5 keytrack=0.4
instrument pad preset dark-pad
instrument lead preset fm-epiano
instrument counter preset fm-bell
instrument acid preset acid
  cutoff 0.14
  resonance 0.78
  envmod 0.3
  accent 0.9
instrument dj scratch
  source drums bars=7-8
  speed 2
  pitch keep
  grain 1/16
instrument riser preset riser
instrument impact preset impact

# ------------------------------------------------------------ harmony

pattern chords
  [E3 G3 B3]:w | [E3 G3 B3]:w | [C3 E3 G3]:w | [C3 E3 G3]:w |
  [E3 G3 B3]:w | [E3 G3 B3]:w | [D3 F#3 A3]:w | [D3 F#3 A3]:w |

pattern chords_high
  [E4 G4 B4]:w | [E4 G4 B4]:w | [C4 E4 G4]:w | [C4 E4 G4]:w |
  [E4 G4 B4]:w | [E4 G4 B4]:w | [D4 F#4 A4]:w | [D4 F#4 A4]:w |

pattern rumble
  E1:q E1 E1 E1 |

# Rolling bass: offbeat 16ths, a fifth at the end of each two bars.
pattern bass
  r:s E1 E1 E1 r E1 E1 E1 r E1 E1 E1 r E1 E1 E1                   |
  r E1 E1 E1 r E1 E1 E1 r E1 E1 E1 r E1 B1 E1                     |
  r C2 C2 C2 r C2 C2 C2 r C2 C2 C2 r C2 C2 C2                     |
  r C2 C2 C2 r C2 C2 C2 r C2 C2 C2 r C2 G1 C2                     |
  r E1 E1 E1 r E1 E1 E1 r E1 E1 E1 r E1 E1 E1                     |
  r E1 E1 E1 r E1 E1 E1 r E1 E1 E1 r E1 B1 E1                     |
  r D1 D1 D1 r D1 D1 D1 r D1 D1 D1 r D1 D1 D1                     |
  r D1 D1 D1 r D1 D1 D1 r D1 D1 D1 r D1 A1 D1                     |

# Glassy 8th-note arp, rising and falling through each chord.
pattern arp
  E3:e@95 G3@70 B3@85 E4@70 G4@100 E4@70 B3@85 G3@70   | E3@95 G3@70 B3@85 E4@70 G4@100 B4@75 G4@85 D4@70   |
  C3@95 E3@70 G3@85 C4@70 E4@100 C4@70 G3@85 E3@70     | C3@95 E3@70 G3@85 C4@70 E4@100 G4@75 E4@85 B3@70   |
  E3@95 G3@70 B3@85 E4@70 G4@100 E4@70 B3@85 G3@70     | E3@95 G3@70 B3@85 E4@70 G4@100 B4@75 G4@85 D4@70   |
  D3@95 F#3@70 A3@85 D4@70 F#4@100 D4@70 A3@85 F#3@70  | D3@95 F#3@70 A3@85 D4@70 F#4@100 A4@75 F#4@85 C4@70 |

# The hook: syncopated, pushing ahead of the beat, on the e-piano.
pattern hook
  r:e B4 E5:q. D5:e B4:q      | G4:e A4 B4:q. r:e D5:q     |
  r:e C5 G5:q. E5:e C5:q      | D5:e E5 G5:q. r:e E5:q     |
  r:e B4 E5:q. D5:e B4:q      | G4:e A4 B4:q. r:e G5:q     |
  F#5:e D5 A4:q. B4:e D5:q    | E5:e D5 B4:q. r:e r:q      |

pattern hook_var
  r:e B4 E5:q. D5:e B4:q      | G4:e A4 B4:q. r:e D5:q     |
  r:e C5 G5:q. E5:e C5:q      | D5:e E5 G5:q. A5:e G5:q    |
  r:e B4 E5:q. D5:e B4:q      | G4:e A4 B4:q. r:e G5:q     |
  F#5:e D5 A4:q. B4:e D5:q    | E5:h. r:q                  |

# Bell counter line: long notes answering the hook.
pattern counter
  r:h E6:h@70    | r:w         | r:h G6:h@60   | r:w         |
  r:h E6:h@70    | r:w         | r:h F#6:h@60  | D6:w@60     |

# 303 bed: low root pulses with slides; the accents (!) are the small peaks.
pattern acid
  E1:s~ E1~ E1 r E1~ E1 r E1~ G1!~ E1 r E1~ E1 r r E1                       |
  E1~ E1 r E1~ E1~ D1 r E1~ E1 r E1~ G1~ E1 r B0~ E1                        |
  C2~ C2~ C2 r C2~ C2 r C2~ E2~ C2 r C2~ C2 r r C2                          |
  C2~ C2 r C2~ C2~ B1 r C2~ C2 r C2~ E2!~ C2 r G1~ C2                       |
  E1~ E1~ E1 r E1~ E1 r E1~ G1!~ E1 r E1~ E1 r r E1                         |
  E1~ E1 r E1~ E1~ D1 r E1~ E1 r E1~ G1~ E1 r B0~ E1                        |
  D1~ D1~ D1 r D1~ D1 r D1~ F#1~ D1 r D1~ D1 r r D1                         |
  D1~ D1 r D1~ D1~ C1 r D1~ D1 r D1~ F#1!~ D1 r A0~ D1                      |

# ------------------------------------------------------------ drums

pattern intro_perc grid=1/16
  hat     x.x.x.x.x.x.x.x.
  openhat ..x...x...x...x.
  rim     .......x......x.

pattern kick_hats grid=1/16
  kick    X...X...X...X...
  openhat ..x...x...x...x.

pattern groove grid=1/16
  kick    X...X...X...X...
  openhat ..x...x...x...x.
  hat     x.x.x.x.x.x.x.x.
  clap    ....x.......x...

pattern groove_full grid=1/16
  kick    X...X...X...X...
  openhat ..x...x...x...x.
  hat     x.x.x.x.x.x.x.x.
  clap    ....X.......X...
  ride    ..x...x...x...x.
  rim     .......x......x.

pattern groove_fill grid=1/16
  kick    X...X...X...X...
  openhat ..x...x...x.....
  hat     x.x.x.x.x.x.x.x.
  clap    ....X.......X...
  snare   ............x6x9

pattern groove_crash grid=1/16
  kick    X...X...X...X...
  openhat ..x...x...x...x.
  hat     x.x.x.x.x.x.x.x.
  clap    ....X.......X...
  crash   X...............

pattern break_perc grid=1/16
  hat     x.x.x.x.x.x.x.x.
  rim     .......x......x.

pattern roll_q grid=1/16
  snare 3...4...4...5...
  hat   x.x.x.x.x.x.x.x.

pattern roll_e grid=1/16
  snare 5.5.6.6.6.6.7.7.
  hat   x.x.x.x.x.x.x.x.

pattern roll_up grid=1/16
  snare 7777888899999999
  kick  X.......X.......

# Beat drop into the synth: bars 7-8 of the drums played backwards at double
# speed, same pitch, over the whole of bar 8 (the drums themselves rest there).
# For two beats instead, use grid=1/2 with `back .x` and `groove_half`.
pattern cut_one grid=1/1
  back x

pattern drums_rest grid=1/16 bars=1
  rim ................

pattern groove_half grid=1/16
  kick    X...X...........
  openhat ..x...x.........
  hat     x.x.x.x.........
  clap    ....x...........

pattern break_hit grid=1/16
  kick  X...............
  crash X...............

pattern rest_bar grid=1/16 bars=1
  rim   ................

pattern impact_note
  E2:w

pattern riser_note
  E4:8/1

# ------------------------------------------------------------ arrangement

track drums
  instrument kit
  layer drums
  gain -17
  reverb 0.05
  eq low=-2 lowfreq=70 high=+2 highfreq=7k
  comp threshold=-14 ratio=4 attack=6ms release=110ms makeup=4 mode=feedback
  play kick_hats x4
  play groove x3
  play drums_rest
  play groove x15
  play groove_fill
  play groove_full x4
  play roll_q x2
  play roll_e
  play roll_up
  play groove_crash
  play groove_full x6
  play groove_fill
  play groove_crash
  play groove_full x6
  play groove_fill
  play break_hit
  play rest_bar x3
  play break_perc x4
  play break_perc x4
  play roll_q x2
  play roll_e
  play roll_up
  play groove_crash
  play groove_full x6
  play groove_fill
  play groove_crash
  play groove_full x6
  play groove_fill
  play groove_crash
  play groove_full x6
  play groove_fill
  play groove_crash
  play groove_full x6
  play groove_fill
  play groove x4
  play kick_hats x3
  play break_hit

track rumble
  instrument rumble
  layer rumble
  gain +2
  sidechain drums depth=0.95 attack=2ms release=0.12
  play rumble x32
  at 33
  play rumble x16
  at 65
  play rumble x32
  at 97
  play rumble x8

track bass
  instrument bass
  layer bass
  gain -1.5
  eq lowcut=30
  sidechain drums depth=0.85 attack=3ms release=0.22
  at 9
  play bass x3
  play bass x2
  at 65
  play bass x4
  play bass

track arp
  instrument arp
  layer arp
  gain +5
  pan -0.15
  reverb 0.3
  delay 0.4
  eq lowcut=250 high=+2 highfreq=4k
  chorus mix=0.25
  sidechain drums depth=0.5 release=0.2
  sweep cutoff from=300 to=900 bars=9-24
  sweep cutoff from=900 to=3500 bars=25-32
  sweep cutoff from=3500 to=3500 bars=33-48
  sweep cutoff from=800 to=1500 bars=49-64
  sweep cutoff from=4000 to=4000 bars=65-96
  sweep cutoff from=4000 to=600 bars=97-104
  at 9
  play arp x2
  play arp
  play arp x2
  play arp x2 vel=0.7
  play arp x4
  play arp vel=0.6

track pad
  instrument pad
  layer pad
  gain -3
  reverb 0.55
  eq lowcut=150 high=+2 highfreq=5k
  chorus mix=0.5
  sidechain drums depth=0.75 release=0.3
  sweep cutoff from=450 to=800 bars=17-32
  at 17
  play chords x2
  play chords_high x2
  play chords x2
  play chords x2
  play chords_high x2
  play chords

track lead
  instrument lead
  layer lead
  gain -8
  pan 0.1
  reverb 0.45
  delay 0.4
  eq lowcut=300 high=+3 highfreq=5k
  chorus mix=0.3
  humanize time=6ms vel=8
  sidechain drums depth=0.35
  at 49
  play hook
  play hook_var
  play hook
  play hook_var
  play hook
  play hook_var

track counter
  instrument counter
  layer lead
  gain -6
  pan -0.25
  reverb 0.5
  delay 0.4
  eq lowcut=400 high=+2 highfreq=5k
  sidechain drums depth=0.35
  at 81
  play counter x2

track acid
  instrument acid
  layer acid
  gain -11
  pan 0.2
  reverb 0.3
  delay 0.3
  eq lowcut=80 highcut=4k
  sidechain drums depth=0.5 release=0.15
  sweep cutoff from=0.1 to=0.22 bars=9-32
  sweep cutoff from=0.2 to=0.3 bars=33-48
  sweep cutoff from=0.25 to=0.42 bars=65-96
  at 9
  play acid x3
  at 33
  play acid x2
  at 65
  play acid x4

track dj
  instrument dj
  layer dj
  gain 0
  at 8
  play cut_one

track riser
  instrument riser
  layer fx
  gain +2
  reverb 0.4
  sweep cutoff from=200 to=5000 bars=25-32
  sweep cutoff from=200 to=5000 bars=57-64
  at 25
  play riser_note
  at 57
  play riser_note

track impact
  instrument impact
  layer fx
  gain -4
  reverb 0.6
  at 33
  play impact_note
  at 49
  play impact_note
  at 65
  play impact_note
  at 97
  play impact_note

master preset techno
  gain 2
  sidechain drums threshold=-30 ratio=8 attack=1ms release=140ms darken=3
