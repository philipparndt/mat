{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "song",
      "camelcase": "Song",
      "title": "Song",
      "scope": "source.song",
      "file-types": ["song"],
      "path": ".",
      "highlights": "queries/highlights.scm",
      "injection-regex": "^song$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "musik-as-text .song files",
    "authors": [
      {
        "name": "Philipp Arndt"
      }
    ],
    "links": {
      "repository": "https://github.com/philipparndt/mat"
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "node": false,
    "python": false,
    "rust": false,
    "swift": false,
    "zig": false
  }
}
